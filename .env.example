# Secrets for o365-to-mailcow. Copy to .env, chmod 600, never commit .env.
# Client secret of the Entra app registration (only for auth_mode = "app").
O365MIG_CLIENT_SECRET=
# mailcow read-write API key (System > Configuration > Access > API).
O365MIG_MAILCOW_API_KEY=
# Optional: fixed token for the web UI (`o365mig web`), at least 16 characters.
# Unset: a new random token at every start, printed with the URL in the log.
# O365MIG_WEB_TOKEN=
